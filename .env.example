# Copy to .env (never commit .env) or export these in your shell.

# Model provider: github | openai | foundry | (leave empty for offline template mode)
ITG_MODEL_PROVIDER=github

# GitHub Models (free). Fine-grained personal access token with the "Models: read" permission.
GITHUB_TOKEN=
# Optional model override (default openai/gpt-4.1-mini)
ITG_MODEL=

# Resilience policy (defaults shown)
ITG_MODEL_TIMEOUT=15
ITG_MODEL_RETRIES=2
ITG_MODEL_RPM=12

# Any OpenAI-compatible endpoint (ITG_MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Microsoft Foundry (ITG_MODEL_PROVIDER=foundry), kept but untested
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
