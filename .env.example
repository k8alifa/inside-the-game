# Copy to .env (never commit .env) or export these in your shell.

# Model provider: foundry-local (free, on your computer) | foundry (Azure) | openai | (empty = offline templates)
# "github" is retired (GitHub Models shut down on 2026-07-30) and falls back to templates.
ITG_MODEL_PROVIDER=foundry-local

# Model alias or deployment name (foundry-local default: phi-4-mini)
ITG_MODEL=

# Resilience policy (defaults shown). The daily cap does not apply to foundry-local.
ITG_MODEL_TIMEOUT=15
ITG_MODEL_RETRIES=2
ITG_MODEL_RPM=12
ITG_MODEL_DAILY_CAP=140
ITG_MODEL_MAX_PROMPT_TOKENS=7000
# Where today's request count is kept (default ~/.cache/insidethegame/model-usage.json)
ITG_USAGE_FILE=

# Microsoft Foundry on Azure (ITG_MODEL_PROVIDER=foundry)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
# ITG_AZURE_AUTH=devicecode   # sign in with a code instead of the Azure CLI

# Any OpenAI-compatible endpoint (ITG_MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
